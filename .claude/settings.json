{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_FORK_SUBAGENT": "0"
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "Write",
      "NotebookEdit",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Agent",
      "Monitor",
      "Skill"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push --delete*)",
      "Bash(git push * --delete*)",
      "Bash(git push --mirror*)",
      "Bash(git push * --mirror*)",
      "Bash(git config --global *)",
      "Bash(gh *)",
      "Bash(sudo *)",
      "Bash(pkill *)",
      "Bash(killall *)",
      "Bash(vercel *)",
      "Bash(npx vercel *)",
      "Bash(netlify *)",
      "Bash(npx netlify *)",
      "Bash(npm publish *)",
      "Bash(npm install -g *)",
      "Bash(npm i -g *)",
      "Bash(npm * --global*)",
      "Bash(npm * -g *)",
      "Read(./.env.local)"
    ]
  }
}
